---
import "@/styles/fonts.css"
import fontLatin from "@/assets/fonts/portfolio-sans-latin.woff2?url"
import { LANGUAGES, getCV, getLangPath, type Lang } from "@/i18n"
interface Props { title: string; lang: Lang }
const { title, lang } = Astro.props
const { summary } = getCV(lang).basics
const alternates = Object.keys(LANGUAGES) as Lang[]
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme")
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    {Astro.site && <><link rel="canonical" href={new URL(getLangPath(lang), Astro.site)} />{alternates.map(alternate => <link rel="alternate" hreflang={alternate} href={new URL(getLangPath(alternate), Astro.site)} />)}</>}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
  </head>
  <body><slot /></body>
</html>
<style is:global>
  :root{--font-sans:"Portfolio Sans","Portfolio Sans Fallback",system-ui,sans-serif;color-scheme:dark}
  :root[data-theme="light"]{color-scheme:light}:root[data-theme="dark"]{color-scheme:dark}
  *,*::before,*::after{box-sizing:border-box}
  html{font-family:var(--font-sans);font-size:100%;line-height:1.6;color:var(--color-text);background:var(--color-paper);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-size-adjust:100%;-webkit-text-size-adjust:100%;scrollbar-width:thin;scrollbar-color:var(--color-rule) transparent}
  ::selection{color:var(--color-paper);background:var(--color-ink)}
  body,figure,h1,h2,h3,h4,p{margin:0}body{padding:0}h1,h2,h3,h4{color:var(--color-ink);text-wrap:balance}p{text-wrap:pretty}a{color:inherit;text-decoration:none}ul,ol{list-style:none;margin:0;padding:0}img,svg{display:block;max-width:100%}button{font:inherit;color:inherit}button,a{-webkit-tap-highlight-color:transparent}:focus-visible{outline:2px solid var(--color-accent);outline-offset:5px}.print{display:none!important}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{transition-duration:0s!important;animation-duration:0s!important}}
  @page{size:A4;margin:14mm 16mm}
  @media print{:root{color-scheme:light!important}html{font-size:11.5px}.no-print,astro-dev-toolbar{display:none!important}.print{display:flex!important}article{break-inside:avoid}}
</style>
