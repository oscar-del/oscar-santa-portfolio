---
import Layout from "@/layouts/Layout.astro"
import Portfolio from "@/components/Portfolio.astro"
import { DEFAULT_LANG, LANGUAGES, getCV, useTranslations, type Lang } from "@/i18n"
export function getStaticPaths() {
  return Object.keys(LANGUAGES).map((lang) => ({
    params: { lang: lang === DEFAULT_LANG ? undefined : lang }, props: { lang }
  }))
}
const lang = Astro.props.lang as Lang
const { name, label } = getCV(lang).basics
---
<Layout title={useTranslations(lang)("meta.title", { name, label })} lang={lang}>
  <Portfolio lang={lang} />
</Layout>
